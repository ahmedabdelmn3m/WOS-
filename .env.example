# WHITEOUT SURVIVAL — Environment Variables
# Copy to .env and fill in your values

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL (recommended for MVP)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Local development
# DATABASE_URL=postgresql://whiteout:whiteout_secret@localhost:5432/battle_predictor

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── FRONTEND ──────────────────────────────────────────────────────────────────
# For Next.js (prefix with NEXT_PUBLIC_ to expose to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production:
# NEXT_PUBLIC_API_URL=https://your-api.railway.app

# ── SECURITY ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
